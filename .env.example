# Sentry Error Tracking
# Get your DSN from https://sentry.io/
SENTRY_DSN=

# GitHub Actions Sentry Integration (set as repository secrets/variables)
# - SENTRY_AUTH_TOKEN: Auth token from https://sentry.io/settings/auth-tokens/ (secret)
# - SENTRY_ORG: Your Sentry organization slug (variable)
# - SENTRY_PROJECT: Your Sentry project slug (variable)

# Debug Mode
# Set to "true" to enable the debug console in the UI
DEBUG_MODE=false
