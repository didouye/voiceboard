# Voiceboard Backend Configuration
# Copy to .env and customize values
# Works with both CLI (docker compose) and Portainer

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Your domain (required)
DOMAIN=voiceboard.example.com

# Django secret key (required)
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key

# PostgreSQL password (required)
POSTGRES_PASSWORD=change-me-in-production

# =============================================================================
# S3/MINIO SETTINGS
# =============================================================================

# MinIO/S3 credentials (required if using embedded or external S3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-in-production
AWS_STORAGE_BUCKET_NAME=voiceboard

# S3 endpoint (default: embedded MinIO)
# For external S3, set to your endpoint (e.g., https://s3.amazonaws.com)
AWS_S3_ENDPOINT_URL=http://minio:9000

# S3 region (only for external S3 like AWS)
# AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Let's Encrypt email (only for docker-compose.letsencrypt.yml)
LETSENCRYPT_EMAIL=admin@example.com

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# CORS allowed origins (default: https://${DOMAIN})
# CORS_ALLOWED_ORIGINS=https://voiceboard.example.com,https://app.example.com

# =============================================================================
# EXTERNAL SERVICES (when not using embedded)
# =============================================================================

# External PostgreSQL (don't activate "db" profile)
# Set POSTGRES_HOST to your external host, or use individual vars:
# POSTGRES_HOST=your-postgres-host
# POSTGRES_PORT=5432
# POSTGRES_DB=voiceboard
# POSTGRES_USER=voiceboard

# External Redis (don't activate "redis" profile)
# REDIS_URL=redis://your-redis-host:6379

# =============================================================================
# DOCKER SETTINGS
# =============================================================================

# Data directory on host (default: ./data)
# DATA_PATH=/var/lib/voiceboard

# Image settings (usually no need to change)
# GITHUB_REPOSITORY_OWNER=didouye
# IMAGE_TAG=latest

# =============================================================================
# SERVICE PROFILES
# =============================================================================
# Activate embedded services with COMPOSE_PROFILES (comma-separated)
# Options: db, redis, s3
#
# Example - all embedded:
#   COMPOSE_PROFILES=db,redis,s3
#
# Example - external PostgreSQL, embedded Redis and MinIO:
#   COMPOSE_PROFILES=redis,s3
#
# In CLI: COMPOSE_PROFILES=db,redis,s3 docker compose up -d
# In Portainer: set COMPOSE_PROFILES in environment variables
